# ==============================================================================
# MedVoice AI - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Durable Cryptographic Audit Ledger)
# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL connection string with SSL required.
# Used by Drizzle ORM to persist the SHA-256 hash-chained clinical audit ledger.
# If omitted or offline, the system safely falls back to an in-memory audit store in dev.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION & ACCESS CONTROL (RBAC)
# ------------------------------------------------------------------------------
# Browser-safe publishable key (must start with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample

# Server-only secret key (must NEVER be exposed with NEXT_PUBLIC_)
CLERK_SECRET_KEY=sk_test_sample

# Client routing redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# 3. CLINICAL REASONING INFERENCE (NVIDIA NIM / LLM Engine)
# ------------------------------------------------------------------------------
# NVIDIA NIM API key for multi-specialist clinical reasoning and SOAP generation.
# If omitted, system falls back to the deterministic local clinical engine.
NVIDIA_API_KEY="nvapi-sample"
NVIDIA_MODEL="openai/gpt-oss-20b"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ------------------------------------------------------------------------------
# Groq Cloud API key for ultra-fast OpenAI-compatible conversational verbalization.
# Uses openai/gpt-oss-120b for high-instruction-fidelity clinical turn verbalization.
# ------------------------------------------------------------------------------
GROQ_API_KEY="gsk-sample"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# ------------------------------------------------------------------------------
# 4. SPEECH-TO-TEXT & AUDIO TELEMETRY (Server-Side STT)
# ------------------------------------------------------------------------------
# Server-only AssemblyAI key for fallback cloud ASR streaming.
# Note: Never prefix with NEXT_PUBLIC_ to prevent browser bundle leakage.
ASSEMBLYAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. AUTOMATED TEST HARNESS & SECURITY (Optional)
# ------------------------------------------------------------------------------
# Secret token required by automated test suites to simulate RBAC roles safely.
INTERNAL_TEST_HARNESS_SECRET=medvoice_test_harness_secret_2026

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING (Upstash Redis REST)
# ------------------------------------------------------------------------------
# Upstash Redis REST URL and token for atomic sliding-window rate limiting
# across multiple application instances (OWASP API4:2023).
# If omitted, system safely falls back to single-instance in-memory rate limiting.
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample_token"
